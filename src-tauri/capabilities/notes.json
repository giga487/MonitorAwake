{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "notes",
  "description": "Local sticky note windows can read their state, move, minimize and save notes.",
  "windows": ["note-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize"
  ]
}
