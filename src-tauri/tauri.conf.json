{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MonitorAwake",
  "version": "0.1.0",
  "identifier": "io.github.giga487.monitorawake",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "mascot",
        "title": "MonitorAwake",
        "width": 160,
        "height": 160,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "center": true
      },
      {
        "label": "controls",
        "title": "MonitorAwake - Notifications",
        "url": "index.html",
        "width": 320,
        "height": 440,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "skipTaskbar": true
      },
      {
        "label": "speech",
        "title": "MonitorAwake — A little thought",
        "url": "index.html",
        "width": 300,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "focusable": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "shortDescription": "Timers and a desktop companion",
    "category": "Utility",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
