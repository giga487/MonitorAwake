{
  "name": "monitorawake",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:widget": "node --experimental-strip-types --test scripts/widget.test.mjs",
    "test:firebase": "node --experimental-strip-types --test scripts/firebase.test.mjs scripts/firebase-auth.test.mjs",
    "test:firestore": "node --experimental-strip-types --test scripts/firestore.test.mjs",
    "tauri": "tauri",
    "desktop:dev": "npm run build && tauri dev",
    "desktop:build": "tauri build",
    "server": "npm run build && cargo run --no-default-features --bin monitorawake-server"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "firebase": "^13.2.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.6"
  }
}
